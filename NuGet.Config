<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- These projects use public packages from nuget.org. Keep restore local
       to this solution instead of inheriting unrelated machine mappings. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
