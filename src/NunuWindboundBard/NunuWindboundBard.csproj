<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>0.44.0.0</Version>
    <Author>Real Nunu</Author>
    <Name>Nunu's Windbound Bard</Name>
    <Punchline>MIDI Editor, Bard Workbench, native ensembles, and concert capture.</Punchline>
    <Description>Windbound Bard MIDI suite with a full piano roll, MIDI event editing, hardware input and output, and local SoundFont audition. Includes MIDI Workbench, Soulweaver Studio, native ensembles, Showmaster, the native Performance HUD toggle, and MP4 concert capture.</Description>
    <Tags>bard;midi;performance;music</Tags>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Local rehearsal only: MeltySynth renders SF2; NAudio WinMM plays 16-bit PCM.
         NuGet dependencies are distributed beside the plugin DLL by the SDK build. -->
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Samples\Bard-37-Note-Calibration.mid" Link="Bard-37-Note-Calibration.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Samples\Bard-Chord-Callback-Test.mid" Link="Bard-Chord-Callback-Test.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Samples\Windbound-MIDI-Instrument-and-Octave-Tags.mid" Link="Windbound-MIDI-Instrument-and-Octave-Tags.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\windbound-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
