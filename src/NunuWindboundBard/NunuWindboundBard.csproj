<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.26.0.0</Version>
    <Author>Real Nunu</Author>
    <Name>Nunu's Windbound Bard</Name>
    <Punchline>Live USB MIDI Piano, native ensembles, Smart Playlists, HUD and Soulweaver.</Punchline>
    <Description>Native FFXIV Ensemble Ready Check with automatic client confirmation and game-synchronised START inspired by MidiBard 2. Includes Soulweaver Studio, chat-safe chords, optional party instrument and playlist setup, compact Performance HUD, native instrument switching, C3-C6 optimiser, smart Solo/Ensemble playlists and full-featured concert tools.</Description>
    <Tags>bard;midi;performance;music</Tags>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\Samples\Bard-37-Note-Calibration.mid" Link="Bard-37-Note-Calibration.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Samples\Bard-Chord-Callback-Test.mid" Link="Bard-Chord-Callback-Test.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Samples\Windbound-MIDI-Instrument-and-Octave-Tags.mid" Link="Windbound-MIDI-Instrument-and-Octave-Tags.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\windbound-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
