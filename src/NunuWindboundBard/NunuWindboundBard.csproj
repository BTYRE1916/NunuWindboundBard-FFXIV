<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.11.1.0</Version>
    <Author>Real Nunu</Author>
    <Name>Nunu's Windbound Bard</Name>
    <Punchline>Soulweaver adaptive arranging for FFXIV Bard Performance.</Punchline>
    <Description>Soulweaver Studio generates Solo, Duet, Quartet and Octet MIDI arrangements with instrument suggestions and party assignments. Also features multi-device ensembles, native instrument switching, per-track octaves, guitar tones, C3-C6 optimisation, chord-aware playback and saved playlists.</Description>
    <Tags>bard;midi;performance;music</Tags>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\Samples\Bard-37-Note-Calibration.mid" Link="Bard-37-Note-Calibration.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Samples\Bard-Chord-Callback-Test.mid" Link="Bard-Chord-Callback-Test.mid" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\windbound-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
